{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/review-trigger.js\" 2>/dev/null || true",
            "statusMessage": "Checking whether code review is needed..."
          }
        ]
      }
    ]
  }
}
